<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oddfar.campus.business.mapper.ModerationRecordMapper">

    <resultMap type="com.oddfar.campus.business.domain.entity.ModerationRecordEntity" id="ModerationRecordResult">
        <id     property="recordId"    column="record_id"/>
        <result property="targetType"  column="target_type"/>
        <result property="targetId"    column="target_id"/>
        <result property="userId"      column="user_id"/>
        <result property="action"      column="action"/>
        <result property="triggerType" column="trigger_type"/>
        <result property="reviewerId"  column="reviewer_id"/>
        <result property="autoReason"  column="auto_reason"/>
        <result property="manualRemark" column="manual_remark"/>
        <result property="riskScore"   column="risk_score"/>
        <result property="createTime"  column="create_time"/>
        <result property="createUser"  column="create_user"/>
        <result property="updateTime"  column="update_time"/>
        <result property="updateUser"  column="update_user"/>
    </resultMap>

    <sql id="selectRecord">
        SELECT r.record_id, r.target_type, r.target_id, r.user_id, r.action,
               r.trigger_type, r.reviewer_id, r.auto_reason, r.manual_remark,
               r.risk_score, r.create_time, r.create_user, r.update_time, r.update_user
        FROM campus_moderation_record r
    </sql>

    <select id="selectRecordPage" parameterType="com.oddfar.campus.business.domain.entity.ModerationRecordEntity"
            resultMap="ModerationRecordResult">
        <include refid="selectRecord"/>
        <where>
            r.del_flag = 0
            <if test="targetType != null">
                AND r.target_type = #{targetType}
            </if>
            <if test="targetId != null">
                AND r.target_id = #{targetId}
            </if>
            <if test="userId != null">
                AND r.user_id = #{userId}
            </if>
            <if test="action != null">
                AND r.action = #{action}
            </if>
            <if test="triggerType != null">
                AND r.trigger_type = #{triggerType}
            </if>
            <if test="params != null and params.beginTime != null and params.beginTime != ''">
                AND date_format(r.create_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')
            </if>
            <if test="params != null and params.endTime != null and params.endTime != ''">
                AND date_format(r.create_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')
            </if>
        </where>
        ORDER BY r.create_time DESC
    </select>

</mapper>
